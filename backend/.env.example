# Import these variables into the Java process environment; Spring does not read this file automatically.
TOY_MACHINE_ID=TF-001
TOY_MACHINE_KEY=replace-with-the-same-random-key-used-by-the-kiosk
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=https://YOUR-DOMAIN/api/webhooks/mercadopago
MP_LIVE_MODE=false
# Requires a payer identity explicitly supported by Mercado Pago for this totem.
# Do not invent customer details or use the merchant email as the player's email.
MP_PIX_PAYER_EMAIL=
# PIN for the hidden admin panel (F8 x3 in the kiosk). Leave empty to disable the panel entirely.
# At least 4 digits. Never reuse TOY_MACHINE_KEY.
ADMIN_PIN=
# Three fixed packages; only override the ones below if the catalog actually changes.
# TOY_PACKAGE_1_ID=pkg-2-5
# TOY_PACKAGE_1_CREDITS=2
# TOY_PACKAGE_1_AMOUNT=5.00
# TOY_PACKAGE_2_ID=pkg-4-10
# TOY_PACKAGE_2_CREDITS=4
# TOY_PACKAGE_2_AMOUNT=10.00
# TOY_PACKAGE_3_ID=pkg-6-15
# TOY_PACKAGE_3_CREDITS=6
# TOY_PACKAGE_3_AMOUNT=15.00
TOY_SESSION_SECONDS=180
SERVER_ADDRESS=127.0.0.1
PORT=8080
# H2 file persists across restarts. Keep data/ and back it up.
DATABASE_URL=jdbc:h2:file:./data/toyfactory;MODE=PostgreSQL;DB_CLOSE_ON_EXIT=FALSE
DATABASE_USER=sa
DATABASE_PASSWORD=
# For a remote production backend, use PostgreSQL and a durable database volume.
# DATABASE_URL=jdbc:postgresql://localhost:5432/toyfactory
